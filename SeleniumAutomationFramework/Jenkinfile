pipeline {
    agent any

    tools {
        jdk 'JDK-17'
        maven 'Maven-Local'
    }

    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                echo "Running Maven tests..."
                // Maven will run in the root where pom.xml exists
                bat '"C:\\ProgramData\\Jenkins\\.jenkins\\tools\\hudson.tasks.Maven_MavenInstallation\\Maven-Local\\bin\\mvn" clean test'
            }
        }

        stage('Publish TestNG Report') {
            steps {
                // Ensure this matches the folder TestNG generates in your pom.xml
                publishHTML(target: [
                    reportDir: 'test-output',       // TestNG output folder
                    reportFiles: 'index.html',      // TestNG generates index.html
                    reportName: 'TestNG Report',
                    keepAll: true,
                    allowMissing: false
                ])
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
    }
}
